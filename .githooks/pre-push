#!/bin/sh
# Refuses a push in the cases docs/conventions/git.md lists under
# "Protecting main". Turned on per clone with
# `git config core.hooksPath .githooks`; `git push --no-verify` skips it.
set -eu

pushed=""
while read -r local_ref local_sha remote_ref _; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: main takes changes only through pull requests; see docs/conventions/git.md" >&2
    exit 1
  fi
  case $local_sha in
    *[!0]*) pushed="$pushed $local_ref:$local_sha" ;; # a ref name never holds a colon
    *) ;; # all zeros: the push deletes a branch
  esac
done

[ -n "$pushed" ] || exit 0
commits=$(for ref in $pushed; do git rev-list "${ref#*:}" --not --remotes=origin; done | sort -u)

checked=0
if [ -n "$commits" ]; then
  # shellcheck disable=SC2086 # one word per commit
  scripts/check-commits.sh $commits || checked=$?
fi
if [ "$checked" -eq 1 ]; then
  echo "pre-push: the commit messages above break docs/conventions/git.md; amend them" >&2
  exit 1
elif [ "$checked" -ne 0 ]; then
  echo "pre-push: scripts/check-commits.sh stopped with exit $checked, above, before it checked every message" >&2
  exit 1
fi

# The check reads each pushed branch's commit rather than its new
# commits, since only that commit's tree reaches main: a branch whose
# later commit moves a nested .gitignore's entries to the root one
# passes, and a branch at a commit origin already has is read too. It
# needs no export or tool, so it refuses before the checks that build a
# branch.
for ref in $pushed; do
  branch=${ref%:*}
  branch=${branch#refs/heads/}
  scanned=0
  scripts/check-gitignore.sh "${ref#*:}" || scanned=$?
  if [ "$scanned" -eq 1 ]; then
    echo "pre-push: $branch tracks the ignore files above; move their entries to the root .gitignore, as above, then delete the files on that branch and amend" >&2
    exit 1
  elif [ "$scanned" -ne 0 ]; then
    echo "pre-push: scripts/check-gitignore.sh stopped with exit $scanned, above, before it checked $branch" >&2
    exit 1
  fi
done

# mise exec runs a tool at the version mise.toml pins, also from a Git
# client that pushes outside a shell where mise is activated.
pinned() {
  if command -v mise >/dev/null 2>&1; then
    mise exec -- "$@"
  else
    "$@"
  fi
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM

# The checks read files, so they run on the pushed commit exported from
# Git: the working tree holds one branch of the push at most, with what
# isn't committed yet.
export_commit() {
  if [ ! -d "$work/$1" ]; then
    mkdir "$work/$1"
    git archive "$1" | tar -x -C "$work/$1"
  fi
}

log="$work/check.log"

# Runs Gradle in an exported commit's backend/, its output in $log.
gradle_on() { # commit gradle-argument...
  (
    cd "$work/$1/backend"
    shift
    pinned ./gradlew "$@" --quiet
  ) >"$log" 2>&1
}

# Refuses the push after a failed Gradle run, with the refusal of the
# first pattern that matches a line Gradle printed in $log. Gradle also
# fails before a check runs, on a build it can't configure, Java that
# doesn't compile or a daemon gone wrong, so a run that matches none
# says so rather than naming the check. The patterns match Gradle's own
# "> …" lines: javac repeats the source line it can't compile, and that
# line can hold any text.
refuse_after_gradle() { # branch check [pattern refusal]...
  cat "$log" >&2
  refused=$1 check=$2
  shift 2
  while [ "$#" -ge 2 ]; do
    if grep -Eq "$1" "$log"; then
      echo "pre-push: $refused $2" >&2
      exit 1
    fi
    shift 2
  done
  echo "pre-push: Gradle stopped on $refused before it ran $check, above; fix what it names on that branch and amend, or, when a commit that passed before fails the same way, run ./gradlew --stop in backend/ and push again" >&2
  exit 1
}

# Runs pnpm in an exported commit's web/, its output in $log.
pnpm_on() { # commit pnpm-argument...
  (
    cd "$work/$1/web"
    shift
    pinned pnpm "$@"
  ) >"$log" 2>&1
}

refuse_after_pnpm() { # branch refusal
  cat "$log" >&2
  echo "pre-push: $1 $2" >&2
  exit 1
}

for ref in $pushed; do
  branch=${ref%:*}
  branch=${branch#refs/heads/}
  sha=${ref#*:}
  [ ! -d "$work/$sha" ] || continue # another ref at this commit passed
  # -z prints each path as it is, where git would quote one holding a
  # character git calls unusual, such as a byte outside ASCII, and the
  # quote would hide the folder it starts with. A path holding a newline
  # reads back as several lines, its start on the first and its end on
  # the last, so it can only run a check it doesn't need.
  changed=$(git rev-list "$sha" --not --remotes=origin |
    while read -r commit; do git diff-tree -m --root --no-commit-id --name-only -r -z "$commit" | tr '\0' '\n'; done)
  # The backend's build generates its web adapter from api/openapi.yaml,
  # so a change to the spec alone can break the backend's compile.
  if printf '%s\n' "$changed" | grep -Eq '^(api|backend)/'; then
    export_commit "$sha"
    gradle_on "$sha" spotlessCheck ||
      refuse_after_gradle "$branch" "the format check" \
        '^> The following files had format violations' \
        "fails the format check above; run ./gradlew spotlessApply in backend/ on that branch and amend" \
        '^> There were [0-9]+ lint error' \
        "fails the format check above: google-java-format can't parse the Java it names; fix that Java on the branch and amend"
    # ArchitectureTest holds the boundaries that the compiler doesn't
    # (ADR 0007), and unlike the HTTP tests it needs no Docker.
    # TODO(#10): CI runs it, with every other test.
    gradle_on "$sha" :app:test --tests dev.ampolatech.ArchitectureTest ||
      refuse_after_gradle "$branch" "the architecture test" \
        '^> There were failing tests' \
        "fails the architecture test above; move or change the classes it names on that branch and amend"
  fi
  # The web app's build generates its client from api/openapi.yaml too,
  # so a change to the spec alone can break the web app's type-check.
  if printf '%s\n' "$changed" | grep -Eq '^(api|web)/'; then
    export_commit "$sha"
    if [ ! -d "$work/$sha/web" ]; then
      echo "pre-push: $branch has no web/ to check; rebase it onto main" >&2
      exit 1
    fi
    pnpm_on "$sha" install --frozen-lockfile ||
      refuse_after_pnpm "$branch" "fails pnpm install --frozen-lockfile above; run pnpm install in web/ on that branch and amend, or run mise install when pnpm is missing"
    pnpm_on "$sha" generate ||
      refuse_after_pnpm "$branch" "fails pnpm generate above; fix the spec or the route it names on that branch and amend"
    pnpm_on "$sha" typecheck ||
      refuse_after_pnpm "$branch" "fails the web app's type-check above; fix the code it names on that branch and amend"
    pnpm_on "$sha" check ||
      refuse_after_pnpm "$branch" "fails Biome's check above; run pnpm fix in web/ on that branch and amend, then fix what it leaves"
  fi
  if printf '%s\n' "$changed" | grep -Eq '^(\.githooks|scripts)/'; then
    export_commit "$sha"
    if ! (cd "$work/$sha" && pinned shellcheck .githooks/* scripts/*.sh); then
      echo "pre-push: $branch fails shellcheck above; fix what it names on that branch and amend, or run mise install when shellcheck is missing" >&2
      exit 1
    fi
  fi
  if printf '%s\n' "$changed" | grep -Eq '\.md$|^\.markdownlint-cli2\.jsonc$|^scripts/(lint-docs|markdownlint-cli2)\.sh$|^mise\.(toml|lock)$'; then
    export_commit "$sha"
    linted=0
    "$work/$sha/scripts/lint-docs.sh" || linted=$?
    if [ "$linted" -eq 1 ]; then
      echo "pre-push: $branch fails the Markdown lint above; fix what it names on that branch and amend" >&2
      exit 1
    elif [ "$linted" -ne 0 ]; then
      echo "pre-push: scripts/lint-docs.sh did not lint $branch, above; run mise install when a tool is missing, or rebase the branch onto main when it predates the script" >&2
      exit 1
    fi
  fi
  # .githooks/ and scripts/ hold the hook and every script it runs, the
  # backend's and the web app's builds aside, so a change to either runs
  # the test, with no list of those scripts to change when the hook runs
  # a new one. The test pushes its fixture branches from a repository
  # whose scripts/test-pre-push.sh is a double, so a fixture that changes
  # either folder runs a double, not the test again.
  if printf '%s\n' "$changed" | grep -Eq '^(\.githooks|scripts)/'; then
    export_commit "$sha"
    tested=0
    "$work/$sha/scripts/test-pre-push.sh" "$sha" || tested=$?
    if [ "$tested" -eq 1 ]; then
      echo "pre-push: $branch's hook fails the cases above; fix the hook, a script it runs or the case on that branch and amend" >&2
      exit 1
    elif [ "$tested" -ne 0 ]; then
      echo "pre-push: scripts/test-pre-push.sh did not test $branch's hook, above; rebase the branch onto main when it predates the script" >&2
      exit 1
    fi
  fi
done
exit 0
