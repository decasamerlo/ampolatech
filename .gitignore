CLAUDE.local.md

# Agents' drafts: commit messages, PR bodies, review notes, handoffs. A
# reboot clears the session's scratchpad, not this folder.
/.scratch/

# Written by IDEs that run the Java language server: the Eclipse metadata
# Buildship imports the Gradle build into, and the classes the IDE
# compiles into each module's bin/. Only bin/ is tied to backend/, since
# a bin/ elsewhere may hold scripts.
.project
.classpath
.settings/
/backend/**/bin/

# Gradle's caches, its Kotlin plugin's, and the build output. Only
# build/ is tied to backend/, since a build/ elsewhere may hold sources.
.gradle/
.kotlin/
/backend/**/build/
