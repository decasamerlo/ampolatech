CLAUDE.local.md

# Agents' drafts: commit messages, PR bodies, review notes, handoffs. A
# reboot clears the session's scratchpad, not this folder.
/.scratch/

# Written by IDEs that run the Java language server: the Eclipse metadata
# Buildship imports the Gradle build into, and the classes the IDE
# compiles into each module's bin/. Only bin/ is tied to backend/, since
# a bin/ elsewhere may hold scripts.
.project
.classpath
.settings/
/backend/**/bin/

# Gradle's caches, its Kotlin plugin's, and the build output. Only
# build/ is tied to backend/, since a build/ elsewhere may hold sources.
.gradle/
.kotlin/
/backend/**/build/

# The web app's installed packages and build output. These and the /web/
# rules below are tied to web/, where the web app's tools write them, since
# a file or folder by one of these names elsewhere may hold what git keeps.
/web/node_modules/
/web/dist/

# Generated by `pnpm generate` and never committed (ADR 0006): the API's
# client from api/openapi.yaml, and the route tree from web/src/routes/.
/web/src/api/generated/
/web/src/routeTree.gen.ts
# Where the route tree's generator writes while it runs.
/web/.tanstack/

# Playwright's output: each test's traces and screenshots, and its reports.
/web/test-results/
/web/playwright-report/
