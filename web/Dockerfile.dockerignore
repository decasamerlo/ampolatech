# The image builds from the repository root and needs only api/ and web/,
# without what the root .gitignore lists under /web/, Playwright's output
# among it, or the Docker files themselves.
*
!api/
!web/
web/node_modules
web/dist
web/src/api/generated
web/src/routeTree.gen.ts
web/.tanstack
web/test-results
web/playwright-report
web/Dockerfile
web/Dockerfile.dockerignore
