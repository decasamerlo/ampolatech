{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "gitignore": true,
  "ignores": [".claude/skills/**"],
  "overrides": [
    {
      "filter": [".github/pull_request_template.md"],
      "config": { "MD041": false },
      "combine": "merge"
    }
  ]
}
